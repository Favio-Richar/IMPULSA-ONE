{
  "name": "@impulza/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite-node --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@impulza/auth": "workspace:*",
    "@impulza/config": "workspace:*",
    "@impulza/database": "workspace:*",
    "@nestjs/common": "12.0.2",
    "@nestjs/core": "12.0.2",
    "@nestjs/platform-express": "12.0.2",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@impulza/eslint-config": "workspace:*",
    "@impulza/tsconfig": "workspace:*",
    "@nestjs/testing": "12.0.2",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.5.1",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "otplib": "13.5.0",
    "supertest": "7.2.2",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vite-node": "6.0.0",
    "vitest": "5.0.0"
  }
}
