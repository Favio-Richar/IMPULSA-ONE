{
  "name": "@impulza/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite-node --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "openapi:generate": "vite-node src/openapi/generate.ts",
    "superadmin": "vite-node src/scripts/superadmin.ts",
    "demo:perfil": "vite-node src/scripts/demo-profile.ts"
  },
  "dependencies": {
    "@impulza/ai": "workspace:*",
    "@impulza/analytics": "workspace:*",
    "@impulza/auth": "workspace:*",
    "@impulza/payments": "workspace:*",
    "@impulza/config": "workspace:*",
    "@impulza/contracts": "workspace:*",
    "@impulza/database": "workspace:*",
    "@impulza/observability": "workspace:*",
    "@impulza/storage": "workspace:*",
    "@impulza/validation": "workspace:*",
    "@nestjs/common": "12.0.2",
    "@nestjs/core": "12.0.2",
    "@nestjs/platform-express": "12.0.2",
    "@nestjs/swagger": "12.0.1",
    "bullmq": "6.3.8",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.17.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@impulza/eslint-config": "workspace:*",
    "@impulza/tsconfig": "workspace:*",
    "@nestjs/testing": "12.0.2",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.5.1",
    "@types/sanitize-html": "2.16.1",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "otplib": "13.5.0",
    "sharp": "0.35.4",
    "supertest": "7.2.2",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vite-node": "6.0.0",
    "vitest": "5.0.0"
  }
}
