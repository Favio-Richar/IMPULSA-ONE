# Copiar a .env.local (o .env) y ajustar. Nunca commitear el archivo real — solo este ejemplo.
# Ver packages/config para la validación tipada de estas variables.

# --- Compartido ---
NODE_ENV=development

# --- apps/api ---
PORT=4000
DATABASE_URL=postgresql://impulza:impulza_local_dev@localhost:55433/impulza
REDIS_URL=redis://localhost:56380
# Orígenes exactos permitidos para CORS (separados por coma) — nunca "*".
CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:3200
# Clave de 32 bytes en base64 para cifrar el secreto TOTP de 2FA. Generar una propia con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Este valor de ejemplo es solo para desarrollo local — nunca reutilizar en staging/producción.
AUTH_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
# Base para construir enlaces de verificación/recuperación en los emails.
APP_BASE_URL=http://localhost:3100

# --- docker-compose.yml (valores por defecto ya usados arriba; solo cambiar si se personaliza) ---
# Puertos no estándar a propósito: en esta máquina de desarrollo ya hay otros proyectos usando
# los puertos por defecto de Postgres/Redis/MinIO (ver README "Puertos locales").
POSTGRES_USER=impulza
POSTGRES_PASSWORD=impulza_local_dev
POSTGRES_DB=impulza
POSTGRES_PORT=55433
REDIS_PORT=56380

# --- MinIO (opcional, perfil "storage" — ver docker-compose.yml) ---
MINIO_ROOT_USER=impulza
MINIO_ROOT_PASSWORD=impulza_local_dev
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
