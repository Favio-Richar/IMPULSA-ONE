# Copiar a .env.local (o .env) y ajustar. Nunca commitear el archivo real — solo este ejemplo.
# Ver packages/config para la validación tipada de estas variables.

# --- Compartido ---
NODE_ENV=development

# --- apps/api ---
PORT=4000
DATABASE_URL=postgresql://impulza:impulza_local_dev@localhost:55433/impulza
REDIS_URL=redis://localhost:56380
# Pruebas automáticas (vitest): base y Redis PROPIOS, nunca los de desarrollo. La base se crea,
# migra y siembra sola antes de cada `pnpm test` (`db:test:prepare`). Su nombre debe contener "test".
TEST_DATABASE_URL=postgresql://impulza:impulza_local_dev@localhost:55433/impulza_test
TEST_REDIS_URL=redis://localhost:56380/1
# Orígenes exactos permitidos para CORS (separados por coma) — nunca "*".
CORS_ORIGINS=http://localhost:3300,http://localhost:3100,http://localhost:3200
# Clave de 32 bytes en base64 para cifrar el secreto TOTP de 2FA. Generar una propia con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Este valor de ejemplo es solo para desarrollo local — nunca reutilizar en staging/producción.
AUTH_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
# Base para construir enlaces de verificación/recuperación en los emails.
APP_BASE_URL=http://localhost:3100
# Soporte (F4.5), opcionales: bandeja del equipo que recibe el aviso de cada solicitud nueva o
# respuesta de un cliente, y URL de apps/admin para el enlace de ese aviso.
SUPPORT_NOTIFICATION_EMAIL=soporte@impulza.local
ADMIN_BASE_URL=http://localhost:3200
# Dominios propios (F4.7): dominio de la plataforma (no reclamable) y destino del CNAME de los
# clientes. Opcionales hasta la decisión #1; en producción se completan al desplegar.
# PLATFORM_DOMAIN=impulza.one
# CUSTOM_DOMAIN_CNAME_TARGET=sitios.impulza.one
# Reservas (F5.4): origen público de apps/web para los enlaces "gestiona tu reserva" de los correos.
PUBLIC_SITE_BASE_URL=http://localhost:3300
# Firma del enlace "gestiona tu reserva" (F5.4): generar uno propio de al menos 32 caracteres,
# igual en la API y el worker. Nunca reutilizar este valor fuera de desarrollo.
BOOKING_LINK_SECRET=dev-only-booking-link-secret-change-me-0000
# Sal para derivar el visitante anonimizado de analítica (F3.4, ADR-004 punto 1): nunca se guarda
# la IP cruda del visitante — se deriva un hash con esta sal, rotado por sitio/día. Generar una
# propia con el mismo comando que AUTH_ENCRYPTION_KEY.
ANALYTICS_SALT_SECRET=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
# Secreto compartido apps/web -> apps/api (F3.6): con él, apps/web reenvía la IP/user-agent/país
# del visitante real y la API les cree (rate limit por visitante, exclusión de bots, visitante
# anonimizado). Sin él, la API ignora esas cabeceras. Debe ser el mismo valor en apps/web
# (INTERNAL_PROXY_SECRET más abajo). Generar uno propio con el mismo comando de arriba.
INTERNAL_PROXY_SECRET=ZXhhbXBsZS1wcm94eS1zZWNyZXQtY2hhbmdlLW1lLXBsZWFzZQ==
# Opcionales (F1.10) — sin SENTRY_DSN, Sentry queda deshabilitado (no-op) y la app arranca igual.
# SENTRY_DSN=https://xxxxx@oXXXXXX.ingest.sentry.io/XXXXXXX
# SENTRY_RELEASE=impulza-one@0.0.0
# Opcionales (F2.7) — URL de apps/web y el secreto de su webhook de invalidación de caché. Sin
# ellas, publicar/restaurar una página siguen funcionando igual: el aviso de caché es best-effort
# (ver RevalidateWebService). El secreto debe coincidir con REVALIDATE_SECRET de apps/web.
WEB_APP_URL=http://localhost:3300
WEB_REVALIDATE_SECRET=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDEyMzQ1Njc4OTAx

# --- apps/worker ---
# Puerto donde el worker expone únicamente GET /health (no es una API pública). Reutiliza
# SENTRY_DSN/SENTRY_RELEASE de arriba (mismo proyecto de Sentry, distinto "service" tag).
WORKER_PORT=4100
# F3.6: el worker procesa la cola de analítica (usa DATABASE_URL/REDIS_URL de arriba) y purga el
# AnalyticsEvent crudo vencido una vez al día (ADR-004 punto 4). Meses de retención, ajustable sin
# tocar código cuando se publique la política de privacidad real.
ANALYTICS_RETENTION_MONTHS=14
# ADR-004 punto 4: meses sin interacción tras los que un contacto queda marcado para que el dueño
# decida si lo conserva (el job solo marca, nunca borra).
CONTACT_RETENTION_REVIEW_MONTHS=36

# --- apps/dashboard ---
# Next.js no lee el .env de la raíz — estos valores también deben copiarse a
# apps/dashboard/.env.local (ver ese archivo). Documentado aquí para tener una sola fuente de
# referencia de todas las variables del proyecto.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Origen público de apps/web (F3.5) — para armar la URL del enlace corto/QR que se muestra en el
# panel. Debe ser el mismo valor que PUBLIC_WEB_BASE_URL de apps/web, más abajo.
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3300
# Opcional (F4.3): enlace externo para solicitar un cambio de plan mientras no haya cobro en línea
# (F4.6). Solo https:// o mailto:. Sin él, la pantalla de planes lo explica en vez de mostrar un botón.
# NEXT_PUBLIC_PLAN_UPGRADE_URL=mailto:ventas@ejemplo.cl

# --- apps/admin (F4.4) ---
# Superadministración. Tampoco lee el .env de la raíz — copiar a apps/admin/.env.local. Solo
# necesita la API: su sesión es propia (ADR-005) y se otorga con
# `pnpm --filter @impulza/api run superadmin -- grant <correo>`.
# NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- apps/web (F2.7) ---
# Tampoco lee el .env de la raíz — copiar a apps/web/.env.local. A diferencia de
# NEXT_PUBLIC_API_URL, estas son server-only (nunca llegan al navegador del visitante): el
# render público corre enteramente en el servidor. REVALIDATE_SECRET debe ser exactamente el mismo
# valor que WEB_REVALIDATE_SECRET de arriba.
API_BASE_URL=http://localhost:4000/api/v1
REVALIDATE_SECRET=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDEyMzQ1Njc4OTAx
# Origen público de apps/web (F2.8): base de canonical, Open Graph, sitemap.xml y robots.txt.
# Sin path ni slash final.
PUBLIC_WEB_BASE_URL=http://localhost:3300
# Origen público de apps/dashboard: la landing enlaza "Crear mi portal" e "Iniciar sesión" hacia el
# panel (`apps/web/lib/env.ts`). Obligatoria: sin ella `next build` de apps/web no arranca.
DASHBOARD_BASE_URL=http://localhost:3100
# Mismo valor que INTERNAL_PROXY_SECRET de apps/api (F3.6).
INTERNAL_PROXY_SECRET=ZXhhbXBsZS1wcm94eS1zZWNyZXQtY2hhbmdlLW1lLXBsZWFzZQ==

# --- docker-compose.yml (valores por defecto ya usados arriba; solo cambiar si se personaliza) ---
# Puertos no estándar a propósito: en esta máquina de desarrollo ya hay otros proyectos usando
# los puertos por defecto de Postgres/Redis/MinIO (ver README "Puertos locales").
POSTGRES_USER=impulza
POSTGRES_PASSWORD=impulza_local_dev
POSTGRES_DB=impulza
POSTGRES_PORT=55433
REDIS_PORT=56380

# --- MinIO (opcional, perfil "storage" — ver docker-compose.yml) ---
MINIO_ROOT_USER=impulza
MINIO_ROOT_PASSWORD=impulza_local_dev
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011

# --- Almacenamiento de medios (ADR-006) ---
# Producción: Cloudflare R2 (endpoint https://<account-id>.r2.cloudflarestorage.com, región "auto",
# STORAGE_PUBLIC_BASE_URL = el dominio público del bucket). Desarrollo: MinIO del docker-compose
# (`docker compose --profile storage up -d minio` y luego `pnpm --filter @impulza/storage run setup:local`).
# Todo o nada: sin ninguna, la API arranca y la subida responde "no configurado"; a medias, no arranca.
STORAGE_ENDPOINT=http://localhost:9010
STORAGE_REGION=auto
STORAGE_BUCKET=impulza-media
STORAGE_ACCESS_KEY_ID=impulza
STORAGE_SECRET_ACCESS_KEY=impulza_local_dev
STORAGE_PUBLIC_BASE_URL=http://localhost:9010/impulza-media
STORAGE_FORCE_PATH_STYLE=true
# Archivos en venta (F5.11b, ADR-015): bucket PRIVADO, distinto del de medios, sin dominio público.
STORAGE_PRIVATE_BUCKET=impulza-private

# --- Video de fondo propio (PP6, ADR-007) ---
# Rutas a ffmpeg y ffprobe del sistema (en producción, el paquete `ffmpeg` de la distribución en la
# imagen del worker). Todo o nada: sin ninguna, la subida de video responde "no configurado"; con una
# sola, o con una ruta que no existe, la API y el worker no arrancan.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Cobro de suscripciones (F4.6, ADR-012). Webpay Oneclick Mall: todas o ninguna (sin ellas, Webpay
# no se ofrece). Abajo, las credenciales PÚBLICAS del ambiente de integración de Transbank (no cobran
# de verdad). En producción: el código "mall", el de la tienda hija y la llave secreta del contrato.
WEBPAY_ENVIRONMENT=integration
WEBPAY_COMMERCE_CODE=597055555541
WEBPAY_CHILD_COMMERCE_CODE=597055555542
WEBPAY_API_KEY_SECRET=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
# Mercado Pago Suscripciones (F4.6b): los dos o ninguno (sin ellos, Mercado Pago no se ofrece).
# Token de acceso de la aplicación y la clave secreta de firma de webhooks ("Tus integraciones" →
# Webhooks). En Mercado Pago registra la URL de notificaciones
#   {API_PUBLIC_URL}/api/v1/billing/mercadopago/webhook
# con los eventos "Planes y suscripciones" (subscription_preapproval y subscription_authorized_payment).
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
# Conexión de las cuentas de Mercado Pago DE LOS NEGOCIOS (F5.8, ADR-013): id, secreto y clave de
# firma de webhooks de la aplicación de Impulza en Mercado Pago, los tres o ninguno. Registra en la
# aplicación la URL de redirección {API_PUBLIC_URL}/api/v1/payments/mercadopago/oauth/callback y
# activa PKCE. Los avisos de pago de los pedidos (F5.9) llegan firmados con esa clave a
# {API_PUBLIC_URL}/api/v1/payments/mercadopago/orders/{pedido}/webhook (la URL va en cada cobro).
# MERCADOPAGO_CLIENT_ID=
# MERCADOPAGO_CLIENT_SECRET=
# MERCADOPAGO_APP_WEBHOOK_SECRET=
# URL pública de esta API (sin /api/v1): Transbank devuelve al cliente a ella tras inscribir la tarjeta.
API_PUBLIC_URL=http://localhost:4000

# Panel de operaciones de superadministración (F7.11): URL del /health del worker. Fuera de producción,
# si falta, se usa http://localhost:4100/health; en producción hay que definirla.
WORKER_HEALTH_URL=http://localhost:4100/health
