    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "turbo": "2.10.13",
    "typescript": "6.0.3"
  }
}
