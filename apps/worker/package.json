    "ioredis": "6.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@impulza/eslint-config": "workspace:*",
    "@impulza/tsconfig": "workspace:*",
    "@types/node": "26.5.1",
    "eslint": "9.39.5",
    "tsx": "4.23.13",
