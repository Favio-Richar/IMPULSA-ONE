# Copiar a .env.local (o .env) y ajustar. Nunca commitear el archivo real — solo este ejemplo.
# Ver packages/config para la validación tipada de estas variables.

# --- Compartido ---
NODE_ENV=development

# --- apps/api ---
PORT=4000
DATABASE_URL=postgresql://impulza:impulza_local_dev@localhost:55433/impulza
REDIS_URL=redis://localhost:56380
# Orígenes exactos permitidos para CORS (separados por coma) — nunca "*".
CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:3200
# Clave de 32 bytes en base64 para cifrar el secreto TOTP de 2FA. Generar una propia con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Este valor de ejemplo es solo para desarrollo local — nunca reutilizar en staging/producción.
AUTH_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
# Base para construir enlaces de verificación/recuperación en los emails.
APP_BASE_URL=http://localhost:3100
# Sal para derivar el visitante anonimizado de analítica (F3.4, ADR-004 punto 1): nunca se guarda
# la IP cruda del visitante — se deriva un hash con esta sal, rotado por sitio/día. Generar una
# propia con el mismo comando que AUTH_ENCRYPTION_KEY.
ANALYTICS_SALT_SECRET=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
# Opcionales (F1.10) — sin SENTRY_DSN, Sentry queda deshabilitado (no-op) y la app arranca igual.
# SENTRY_DSN=https://xxxxx@oXXXXXX.ingest.sentry.io/XXXXXXX
# SENTRY_RELEASE=impulza-one@0.0.0
# Opcionales (F2.7) — URL de apps/web y el secreto de su webhook de invalidación de caché. Sin
# ellas, publicar/restaurar una página siguen funcionando igual: el aviso de caché es best-effort
# (ver RevalidateWebService). El secreto debe coincidir con REVALIDATE_SECRET de apps/web.
WEB_APP_URL=http://localhost:3000
WEB_REVALIDATE_SECRET=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDEyMzQ1Njc4OTAx

# --- apps/worker ---
# Puerto donde el worker expone únicamente GET /health (no es una API pública). Reutiliza
# SENTRY_DSN/SENTRY_RELEASE de arriba (mismo proyecto de Sentry, distinto "service" tag).
WORKER_PORT=4100

# --- apps/dashboard ---
# Next.js no lee el .env de la raíz — este valor también debe copiarse a apps/dashboard/.env.local
# (ver ese archivo). Documentado aquí para tener una sola fuente de referencia de todas las
# variables del proyecto.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- apps/web (F2.7) ---
# Tampoco lee el .env de la raíz — copiar a apps/web/.env.local. A diferencia de
# NEXT_PUBLIC_API_URL, estas son server-only (nunca llegan al navegador del visitante): el
# render público corre enteramente en el servidor. REVALIDATE_SECRET debe ser exactamente el mismo
# valor que WEB_REVALIDATE_SECRET de arriba.
API_BASE_URL=http://localhost:4000/api/v1
REVALIDATE_SECRET=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDEyMzQ1Njc4OTAx
# Origen público de apps/web (F2.8): base de canonical, Open Graph, sitemap.xml y robots.txt.
# Sin path ni slash final.
PUBLIC_WEB_BASE_URL=http://localhost:3000

# --- docker-compose.yml (valores por defecto ya usados arriba; solo cambiar si se personaliza) ---
# Puertos no estándar a propósito: en esta máquina de desarrollo ya hay otros proyectos usando
# los puertos por defecto de Postgres/Redis/MinIO (ver README "Puertos locales").
POSTGRES_USER=impulza
POSTGRES_PASSWORD=impulza_local_dev
POSTGRES_DB=impulza
POSTGRES_PORT=55433
REDIS_PORT=56380

# --- MinIO (opcional, perfil "storage" — ver docker-compose.yml) ---
MINIO_ROOT_USER=impulza
MINIO_ROOT_PASSWORD=impulza_local_dev
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
