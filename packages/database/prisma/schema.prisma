// Esquema inicial — entidades de identidad/organización del ERD (docs/architecture/ERD.md §1-2,
// §8). Reservas/catálogo/pedidos/pagos de negocio se agregan en Fase 5 (ERD.md §10) — no antes,
// para no crear tablas vacías.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Sesión del panel (`USER`) o de superadministración (`ADMIN`, ADR-005): cada guard acepta solo la
// suya, así una cookie no vale en la otra puerta aunque alguien copie el identificador.
enum SessionScope {
  USER
  ADMIN
}

// ADR-005 §6: una organización bloqueada no sirve sus superficies públicas y su panel queda en solo
// lectura.
enum OrganizationStatus {
  ACTIVE
  BLOCKED
}

// Soporte mínimo (F4.5). OPEN = espera respuesta del equipo; ANSWERED = el equipo respondió y
// espera al cliente; CLOSED = cerrada por el equipo (el cliente abre una nueva si hace falta).
enum SupportTicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum SupportAuthorRole {
  CUSTOMER
  STAFF
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  // F4.6a: creada al inscribir el medio de pago, antes de que se apruebe el primer cobro. No da
  // derecho al plan (no está en los estados con derecho de PlansService).
  INCOMPLETE
}

// Cobro de suscripciones (F4.6, ADR-012).
enum PaymentGateway {
  WEBPAY_ONECLICK
  MERCADO_PAGO
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

// PENDING: enviado a la pasarela sin respuesta conocida (timeout) — se concilia antes de reintentar.
enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

// OPEN: el navegador fue a la pasarela. Termina en COMPLETED (suscripción creada), FAILED o EXPIRED.
enum BillingCheckoutStatus {
  OPEN
  // Tomada por un retorno de la pasarela: un segundo retorno con el mismo token no hace nada.
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

// Documento tributario (boleta/factura electrónica) de un pago aprobado. Emisor `MANUAL` en
// ADR-012 §4: queda PENDING hasta que alguien lo emita y lo marque.
// Cuenta de cobro conectada de un negocio (F5.8, ADR-013).
enum PaymentAccountStatus {
  CONNECTED
  // La renovación del token falló o Mercado Pago revocó el acceso: no se cobra hasta reconectar.
  ERROR
}

enum TaxDocumentStatus {
  PENDING
  ISSUED
  NOT_REQUIRED
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String    @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)

  // Bloqueo temporal tras intentos abusivos (ST §7/§15) — defensa por cuenta, además del rate
  // limiting por IP a nivel de endpoint.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)

  // Diseño de datos de 2FA (F1.4): el secreto se guarda cifrado (ver packages/auth), nunca en
  // claro. No se exige en el login todavía — eso llega antes de producción comercial (ST §7).
  twoFactorEnabled         Boolean @default(false) @map("two_factor_enabled")
  twoFactorSecretEncrypted String? @map("two_factor_secret_encrypted")

  // Superadministración de la plataforma (ADR-005). Nunca se otorga desde la API: solo el script
  // de operación `superadmin` del servidor, que además exige 2FA activo.
  isSuperAdmin Boolean @default(false) @map("is_super_admin")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions             Session[]
  accounts             Account[]
  memberships          Membership[]
  verificationTokens   VerificationToken[]
  auditLogsAsActor     AuditLog[]          @relation("AuditLogActor")
  pageVersionsCreated  PageVersion[]       @relation("PageVersionAuthor")
  contactsAssigned     Contact[]           @relation("ContactAssignee")
  supportTicketsOpened SupportTicket[]     @relation("SupportTicketOpener")
  supportMessages      SupportMessage[]    @relation("SupportMessageAuthor")
  mediaUploaded        MediaAsset[]        @relation("MediaUploader")
  campaignsCreated     Campaign[]          @relation("CampaignAuthor")
  aiUsage              AiUsage[]           @relation("AiUsageUser")
  billingCheckouts     BillingCheckout[]
  legalAcceptances     LegalAcceptance[]

  @@map("users")
}

model Session {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(6)
  scope     SessionScope @default(USER)
  userAgent String?      @map("user_agent")
  // Nunca la IP completa en texto plano — hash/truncada (ST §8, no negociable de privacidad).
  ipHash    String?      @map("ip_hash")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Organization {
  id            String             @id @default(uuid()) @db.Uuid
  name          String
  slug          String             @unique
  planId        String?            @map("plan_id") @db.Uuid
  // Bloqueo manual desde superadministración (ADR-005 §6). Motivo obligatorio y auditado.
  status        OrganizationStatus @default(ACTIVE)
  blockedAt     DateTime?          @map("blocked_at") @db.Timestamptz(6)
  blockedReason String?            @map("blocked_reason")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  plan                Plan?                @relation(fields: [planId], references: [id])
  memberships         Membership[]
  subscriptions       Subscription[]
  usageCounters       UsageCounter[]
  auditLogs           AuditLog[]
  sites               Site[]
  siteDomains         SiteDomain[]
  bookingSettings     BookingSettings[]
  bookableServices    BookableService[]
  bookingBlackouts    BookingBlackout[]
  bookingBranches     BookingBranch[]
  bookingStaff        BookingStaff[]
  bookings            Booking[]
  productCategories   ProductCategory[]
  products            Product[]
  productVariants     ProductVariant[]
  productFiles        ProductFile[]
  orders              Order[]
  orderItems          OrderItem[]
  coupons             Coupon[]
  campaigns           Campaign[]
  themes              Theme[]
  contacts            Contact[]
  shortLinks          ShortLink[]
  qrCodes             QrCode[]
  analyticsEvents     AnalyticsEvent[]
  analyticsAggregates AnalyticsAggregate[]
  supportTickets      SupportTicket[]
  mediaAssets         MediaAsset[]
  aiUsage             AiUsage[]
  abTests             AbTest[]
  funnels             Funnel[]
  pageCampaigns       PageCampaign[]
  automations         Automation[]
  automationRuns      AutomationRun[]
  payments            Payment[]
  billingCheckouts    BillingCheckout[]
  legalAcceptances    LegalAcceptance[]
  paymentAccounts     PaymentAccount[]
  webhookEndpoints    WebhookEndpoint[]
  webhookDeliveries   WebhookDelivery[]
  newsletterConfirmations NewsletterConfirmation[]
  emailSequences      EmailSequence[]
  emailSequenceEnrollments EmailSequenceEnrollment[]
  emailSequenceSends  EmailSequenceSend[]
  googleCalendarConnections GoogleCalendarConnection[]

  @@map("organizations")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  status         MembershipStatus @default(INVITED)
  invitedAt      DateTime         @default(now()) @map("invited_at") @db.Timestamptz(6)
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  // Un usuario tiene una sola membresía (y por lo tanto un solo rol) por organización.
  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  // OWNER, ADMIN, EDITOR, ANALYST, SUPPORT, AGENCY_MANAGER, SUPER_ADMIN (ST §7) — catálogo
  // completo de permisos por rol se implementa en F1.6.
  name        String  @unique
  description String?

  memberships Membership[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Plan {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique
  name         String
  // Precio en unidad mínima de moneda + código ISO — nunca float (ST §8). CLP no tiene decimales:
  // la unidad mínima es el peso. Mensual y anual (PM §7.5, F4.1).
  priceMonthly Int      @map("price_monthly")
  priceYearly  Int      @default(0) @map("price_yearly")
  currency     String
  // Validado con `planLimitsSchema` (`@impulza/validation`) en cada lectura — nunca JSON libre.
  limits       Json
  // Orden del comparador (Gratis primero).
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organizations    Organization[]
  subscriptions    Subscription[]
  billingCheckouts BillingCheckout[]

  @@map("plans")
}

model Subscription {
  id                        String             @id @default(uuid()) @db.Uuid
  organizationId            String             @map("organization_id") @db.Uuid
  planId                    String             @map("plan_id") @db.Uuid
  status                    SubscriptionStatus @default(TRIALING)
  currentPeriodStart        DateTime           @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd          DateTime           @map("current_period_end") @db.Timestamptz(6)
  // Referencia del proveedor de pago — nunca datos de tarjeta (ST §12, no negociable).
  externalProviderRef       String?            @map("external_provider_ref")
  // F4.6 (ADR-012). Nula en suscripciones anteriores a F4.6 (no había ninguna cobrada).
  gateway                   PaymentGateway?
  billingCycle              BillingCycle       @default(MONTHLY) @map("billing_cycle")
  // Referencia reutilizable del medio de pago (`tbk_user`), cifrada con AUTH_ENCRYPTION_KEY.
  paymentMethodRefEncrypted String?            @map("payment_method_ref_encrypted")
  // Solo lo que se puede mostrar de una tarjeta: marca y últimos 4 dígitos.
  cardBrand                 String?            @map("card_brand")
  cardLast4                 String?            @map("card_last4")
  // Cancelada por el cliente: sigue con derecho hasta `currentPeriodEnd` y no se renueva.
  cancelAtPeriodEnd         Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt                DateTime?          @map("canceled_at") @db.Timestamptz(6)
  // Primer cobro aprobado: inicio del plazo de retracto (Ley 19.496 art. 3 bis b).
  firstPaidAt               DateTime?          @map("first_paid_at") @db.Timestamptz(6)
  // Morosidad: cobros fallidos del período en curso y cuándo intentar de nuevo.
  failedAttempts            Int                @default(0) @map("failed_attempts")
  nextChargeAt              DateTime?          @map("next_charge_at") @db.Timestamptz(6)
  pastDueSince              DateTime?          @map("past_due_since") @db.Timestamptz(6)
  createdAt                 DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])
  payments     Payment[]

  // Además (migración F4.6a): índice único parcial `subscriptions_one_live_per_org` — a lo más una
  // suscripción TRIALING/ACTIVE/PAST_DUE por organización.
  @@index([organizationId])
  @@index([status, nextChargeAt])
  @@map("subscriptions")
}

model UsageCounter {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  metric         String
  period         String
  value          Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metric, period])
  @@map("usage_counters")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  // Nullable: acciones de superadmin no siempre pertenecen a una organización (ADR-002 §4).
  organizationId String?  @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String
  targetType     String   @map("target_type")
  targetId       String?  @map("target_id")
  // Nunca secretos/contraseñas/tokens en metadata (ST §16, no negociable).
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([actorId])
  @@map("audit_logs")
}

// F7.11 (ADR-026, ERD §8): Banderas de funcionalidad globales o con reglas por organización
model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String
  enabled     Boolean  @default(false)
  rules       Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("feature_flags")
}

model VerificationToken {
  id        String                @id @default(uuid()) @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  // Nunca el token en claro — solo su hash SHA-256 (ver packages/auth). El token crudo se envía
  // una vez al usuario (email) y no se puede recuperar desde la base de datos.
  tokenHash String                @unique @map("token_hash")
  type      VerificationTokenType
  expiresAt DateTime              @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?             @map("used_at") @db.Timestamptz(6)
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------------------------
// Fase 2 — Sitios, páginas y bloques (ERD.md §3).
//
// Nota de nomenclatura: el ERD llama `order` al campo de orden de Page/Block; acá se llama
// `position` porque `order` es palabra reservada de SQL. Es el mismo concepto.
// ---------------------------------------------------------------------------------------------

enum SiteStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

enum PageVisibility {
  PUBLIC
  HIDDEN
}

enum SiteDomainType {
  SUBDOMAIN
  CUSTOM
}

enum DomainVerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

enum DomainSslStatus {
  PENDING
  ACTIVE
  FAILED
}

model Site {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  name           String
  // Único global: es la identidad pública del sitio (slug.dominio). La reserva de nombres
  // (www, api, admin, ...) y la colisión con redirecciones vivas se validan en servidor (F2.2).
  slug           String     @unique
  status         SiteStatus @default(DRAFT)
  themeId        String?    @map("theme_id") @db.Uuid
  // Fondo de la página (PP3): `siteBackgroundSchema` de `@impulza/validation`, validado al guardar
  // y otra vez al leer. `null` = el fondo del tema. En vivo, como el tema: no va en la publicación.
  background     Json?
  // Medición de terceros (F7.1, ADR-016): solo identificadores (`CHECK` de formato en la base). Se
  // cargan en la página pública únicamente con el consentimiento del visitante.
  ga4MeasurementId String?  @map("ga4_measurement_id")
  metaPixelId      String?  @map("meta_pixel_id")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  theme               Theme?               @relation(fields: [themeId], references: [id], onDelete: SetNull)
  pages               Page[]
  domains             SiteDomain[]
  slugRedirects       SiteSlugRedirect[]
  bookingSettings     BookingSettings?
  bookableServices    BookableService[]
  bookingBlackouts    BookingBlackout[]
  bookingBranches     BookingBranch[]
  bookingStaff        BookingStaff[]
  bookings            Booking[]
  googleCalendarConnections GoogleCalendarConnection[]
  productCategories   ProductCategory[]
  products            Product[]
  productVariants     ProductVariant[]
  orders              Order[]
  coupons             Coupon[]
  forms               Form[]
  analyticsEvents     AnalyticsEvent[]
  analyticsAggregates AnalyticsAggregate[]
  abTests             AbTest[]
  funnels             Funnel[]
  pageCampaigns       PageCampaign[]
  newsletterConfirmations NewsletterConfirmation[]

  @@index([organizationId])
  @@map("sites")
}

// Dominio de un sitio (F4.7). `domain` NO es único global: un reclamo pendiente no puede bloquear al
// dueño real (toma de dominio por ocupación). La garantía es el índice único parcial
// `site_domains_one_verified_per_domain (domain) WHERE verification_status = 'VERIFIED'` (en la
// migración, Prisma no expresa índices parciales): un dominio queda verificado en un solo sitio.
// Se verifica con un registro DNS TXT con `verificationToken`, que solo el dueño del DNS puede crear.
model SiteDomain {
  id                 String                   @id @default(uuid()) @db.Uuid
  organizationId     String                   @map("organization_id") @db.Uuid
  siteId             String                   @map("site_id") @db.Uuid
  // En minúsculas, sin punto final, ASCII (punycode). Validado con `customDomainSchema`.
  domain             String
  type               SiteDomainType           @default(SUBDOMAIN)
  verificationStatus DomainVerificationStatus @default(PENDING) @map("verification_status")
  // Valor esperado en el TXT `_impulza.<dominio>`. Aleatorio por reclamo, nunca se reutiliza.
  verificationToken  String                   @map("verification_token")
  verifiedAt         DateTime?                @map("verified_at") @db.Timestamptz(6)
  lastCheckedAt      DateTime?                @map("last_checked_at") @db.Timestamptz(6)
  // Código estable del último fallo (`DOMAIN_CHECK_ERRORS`), nunca texto libre del resolvedor DNS.
  lastCheckError     String?                  @map("last_check_error")
  // La emisión de SSL depende del hosting (F4.8): hasta entonces queda PENDING.
  sslStatus          DomainSslStatus          @default(PENDING) @map("ssl_status")
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, domain])
  @@index([siteId])
  @@index([organizationId])
  @@index([domain])
  @@map("site_domains")
}

// No está en el ERD original: lo exige el criterio de F2.2 ("cambiar el slug de un sitio
// publicado deja una redirección registrada") y PM §9.14 ("Redirecciones"). Se agregó también a
// ERD.md §3 para no dejar el modelo de datos desalineado de la implementación.
model SiteSlugRedirect {
  id        String   @id @default(uuid()) @db.Uuid
  siteId    String   @map("site_id") @db.Uuid
  // Único global por la misma razón que Site.slug: resuelve una URL pública. Que un `fromSlug`
  // no colisione con un Site.slug vivo es una regla entre tablas — se valida en servidor (F2.2).
  fromSlug  String   @unique @map("from_slug")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("site_slug_redirects")
}

model Page {
  id         String         @id @default(uuid()) @db.Uuid
  siteId     String         @map("site_id") @db.Uuid
  slug       String
  // Orden persistente dentro del sitio. Sin restricción de unicidad a propósito: reordenar
  // intercambia posiciones y un UNIQUE no diferido fallaría a mitad de la transacción.
  position   Int
  visibility PageVisibility @default(PUBLIC)
  status     PageStatus     @default(DRAFT)
  // Página de inicio del sitio: no se puede eliminar ni cambiar de slug (F2.3).
  isHome     Boolean        @default(false) @map("is_home")
  // Título, descripción, canonical, robots y Open Graph (F2.8). Validado por Zod en servidor.
  seoMeta    Json?          @map("seo_meta")
  // Smart CTA (F6.6): reglas que cambian la acción principal (`smartCtaSchema` de
  // `@impulza/validation`, validado al guardar y otra vez al leer). En vivo, como el tema y las
  // pruebas A/B: no va en la publicación. `null` = sin reglas.
  smartCta   Json?          @map("smart_cta")
  // Borrado lógico (F2.3): borrar una página no puede destruir su historial de versiones — es
  // trabajo del usuario (CLAUDE.md). La purga definitiva es una operación aparte y explícita.
  deletedAt  DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  site     Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  blocks   Block[]
  versions PageVersion[]
  abTests  AbTest[]
  campaigns PageCampaign[]

  // Resolución del render público: slug de página dentro del sitio (ERD.md §3).
  //
  // La unicidad real es un índice **parcial** (`WHERE deleted_at IS NULL`), creado con SQL en la
  // migración: Prisma no sabe expresarlo. Sin "parcial", una página borrada seguiría reservando
  // su slug para siempre y el usuario no podría volver a usar ese nombre. Acá queda solo el
  // índice de búsqueda; la restricción la impone Postgres igual y sigue emitiendo P2002.
  @@index([siteId, slug])
  @@index([siteId, position])
  @@map("pages")
}

model PageVersion {
  id              String    @id @default(uuid()) @db.Uuid
  pageId          String    @map("page_id") @db.Uuid
  versionNumber   Int       @map("version_number")
  // Snapshot inmutable del contenido completo al publicar — es lo que permite restaurar sin
  // depender del estado actual de los bloques (F2.6).
  contentSnapshot Json      @map("content_snapshot")
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)
  createdById     String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  page      Page  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdBy User? @relation("PageVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([pageId, versionNumber])
  @@index([pageId])
  @@map("page_versions")
}

model Block {
  id                  String    @id @default(uuid()) @db.Uuid
  pageId              String    @map("page_id") @db.Uuid
  // Catálogo cerrado de tipos con esquema Zod versionado por tipo (F2.4). String y no enum de
  // Postgres a propósito: la biblioteca de bloques crece (PM §9.3) y no queremos una migración
  // por cada tipo nuevo. La fuente de verdad del catálogo vive en
  // packages/validation/src/blocks/catalog.ts — se puso ahí y no en este paquete porque el
  // constructor (F2.9) necesita los mismos esquemas en el cliente, y `validation` es isomorfo.
  type                String
  position            Int
  // Permite renderizar de forma degradada un bloque guardado con un esquema más nuevo (F2.4).
  configSchemaVersion Int       @default(1) @map("config_schema_version")
  visible             Boolean   @default(true)
  scheduledStart      DateTime? @map("scheduled_start") @db.Timestamptz(6)
  scheduledEnd        DateTime? @map("scheduled_end") @db.Timestamptz(6)
  // Acción principal de la página (PP5): se destaca y, en el teléfono, queda fija abajo. Solo
  // bloques de acción (`PRIMARY_ACTION_BLOCK_TYPES`) y **a lo sumo uno por página**: lo garantiza
  // un índice único parcial (`WHERE is_primary`) creado con SQL en la migración — Prisma no sabe
  // expresarlo, igual que el slug de página.
  isPrimary           Boolean   @default(false) @map("is_primary")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  page     Page           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  versions BlockVersion[]
  abTests  AbTest[]

  @@index([pageId, position])
  @@map("blocks")
}

model BlockVersion {
  id            String   @id @default(uuid()) @db.Uuid
  blockId       String   @map("block_id") @db.Uuid
  versionNumber Int      @map("version_number")
  // Configuración tipada por `Block.type` — nunca HTML/JS arbitrario (ST §22, no negociable).
  config        Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  block Block @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([blockId, versionNumber])
  @@index([blockId])
  @@map("block_versions")
}

model Theme {
  id             String   @id @default(uuid()) @db.Uuid
  // Null = tema del catálogo global de Impulza One; con valor = tema propio de la organización.
  organizationId String?  @map("organization_id") @db.Uuid
  // Solo para los temas del catálogo, para que el seed sea idempotente. Los temas propios de una
  // organización lo dejan en null (Postgres permite múltiples NULL en un índice único).
  code           String?  @unique
  name           String
  // Paleta, tipografía, radios, espaciado y densidad. El usuario elige de un conjunto validado
  // en servidor — nunca CSS libre (F2.5).
  tokens         Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sites        Site[]

  @@index([organizationId])
  @@map("themes")
}

// Plantilla del catálogo global (PL1, PM §7.4, ERD `Template`): tema + fondo + bloques iniciales
// con contenido de ejemplo por rubro. Contenido de la plataforma, no de un tenant: sin
// `organizationId`, solo lectura para los clientes, sembrada por `prisma/seed.ts` desde
// `TEMPLATE_CATALOG`. Cada columna JSON y cada etiqueta se valida con `templateSchema` de
// `@impulza/validation` al sembrar y otra vez al leer (los mismos esquemas de bloques que el
// constructor). Aplicarla copia su contenido al sitio (PL4): el sitio nunca queda atado a ella, por
// eso no hay FK desde `Site`/`Page`.
model Template {
  id              String   @id @default(uuid()) @db.Uuid
  // Identificador estable (`profesional-servicios`, …): hace idempotente el seed.
  code            String   @unique
  name            String
  description     String
  // Etiquetas cerradas (`TEMPLATE_INDUSTRIES`, `TEMPLATE_OBJECTIVES`): filtros de la galería.
  industryTags    String[] @map("industry_tags")
  objectiveTags   String[] @map("objective_tags")
  // FK lógica a `THEME_CATALOG` (código, no id): el catálogo de temas vive en código y el id de la
  // fila `themes` cambia entre entornos.
  themeCode       String   @map("theme_code")
  // Línea de estilo (`THEME_FAMILIES`); siempre la del tema.
  family          String
  // Mismo esquema que `Site.background`, solo color o degradado. `null` = el fondo del tema.
  background      Json?
  previewImageUrl String?  @map("preview_image_url")
  // Lista ordenada de bloques con su configuración de ejemplo, formato del snapshot de
  // `PageVersion` (`type`, `configSchemaVersion`, `isPrimary`, `config`).
  blocksSeed      Json     @map("blocks_seed")
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  isFeatured      Boolean  @default(false) @map("is_featured")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([sortOrder])
  @@index([isActive])
  @@map("templates")
}

// ---------------------------------------------------------------------------------------------
// Fase 3 — Conversión: formularios, contactos, QR/enlaces cortos y analítica (ERD.md §5/§6/§7).
//
// Privacidad y retención: ver docs/decisions/ADR-004-privacidad-retencion-datos.md (Ley 21.719).
// - `AnalyticsEvent` no tiene columna de IP cruda a propósito (minimización, ADR-004 punto 1).
// - `Contact` guarda el consentimiento auditado (ADR-004 punto 3), no solo un estado genérico.
// - `AnalyticsAggregate.siteId` es obligatorio (a diferencia de `AnalyticsEvent.siteId`, que sí es
//   nullable): un agregado siempre está pre-calculado por sitio; un rollup a nivel de organización
//   se calcula sumando en la consulta del dashboard, no se persiste aparte. `ERD.md` §7 no marcaba
//   esto explícitamente — se aclaró ahí mismo al implementar (CLAUDE.md: no redefinir el ERD sin
//   justificarlo).
// ---------------------------------------------------------------------------------------------

enum FormType {
  CONTACT
  QUOTE
  REGISTRATION
  SURVEY
  ORDER
}

enum FormFieldType {
  TEXT
  TEXTAREA
  EMAIL
  PHONE
  NUMBER
  SELECT
  CHECKBOX
  // Campo dedicado de consentimiento (ADR-004 punto 3): permite detectar en servidor, sin
  // adivinar por texto de la etiqueta, si un formulario puede crear un Contact con seguimiento.
  CONSENT
}

enum ConsentStatus {
  GRANTED
  WITHDRAWN
  // Contacto creado sin paso por un formulario público (alta manual, import) — no aplica la
  // misma exigencia de consentimiento explícito que a un formulario público (ADR-004 punto 3).
  UNKNOWN
}

enum ContactCommercialStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum ContactEventType {
  FORM_SUBMISSION
  BOOKING
  PURCHASE
  NOTE
  // F7.4: confirmó su suscripción a la newsletter.
  NEWSLETTER
}

model Form {
  id            String   @id @default(uuid()) @db.Uuid
  siteId        String   @map("site_id") @db.Uuid
  name          String
  type          FormType @default(CONTACT)
  // Mensaje y/o redirect tras un envío exitoso — validado por Zod en servidor (F3.2), nunca HTML
  // libre (mismo criterio que Block.config, ST §22).
  successAction Json     @map("success_action")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  site        Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  fields      FormField[]
  submissions FormSubmission[]

  @@index([siteId])
  @@map("forms")
}

model FormField {
  id              String        @id @default(uuid()) @db.Uuid
  formId          String        @map("form_id") @db.Uuid
  type            FormFieldType
  label           String
  required        Boolean       @default(false)
  // Opciones para SELECT; regla condicional de visibilidad (F3.2). Nunca ejecutado como código —
  // solo datos que el motor de formularios interpreta (mismo criterio que Block.config).
  options         Json?
  conditionalRule Json?         @map("conditional_rule")
  position        Int
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, position])
  @@map("form_fields")
}

model FormSubmission {
  id        String   @id @default(uuid()) @db.Uuid
  formId    String   @map("form_id") @db.Uuid
  contactId String?  @map("contact_id") @db.Uuid
  payload   Json
  source    String?
  utm       Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  form    Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  // Cascade: borrar un Contact (derecho de cancelación, ADR-004 punto 5) borra sus envíos.
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([contactId])
  @@map("form_submissions")
}

model Contact {
  id                          String                  @id @default(uuid()) @db.Uuid
  organizationId              String                  @map("organization_id") @db.Uuid
  name                        String?
  // Unicidad (organization_id, email) cuando email no es null: índice único parcial creado con
  // SQL en la migración (mismo patrón que Page.slug en F2.3 — Prisma no expresa parciales).
  email                       String?
  phone                       String?
  source                      String?
  tags                        String[]                @default([])
  // Consentimiento auditado (ADR-004 punto 3): qué se aceptó, de dónde y cuándo.
  consentStatus               ConsentStatus           @default(UNKNOWN) @map("consent_status")
  consentSource               String?                 @map("consent_source")
  consentTextVersion          String?                 @map("consent_text_version")
  consentAt                   DateTime?               @map("consent_at") @db.Timestamptz(6)
  commercialStatus            ContactCommercialStatus @default(NEW) @map("commercial_status")
  assignedToId                String?                 @map("assigned_to") @db.Uuid
  // ADR-004 punto 4: el job diario del worker lo marca cuando el contacto lleva
  // CONTACT_RETENTION_REVIEW_MONTHS (36 por defecto) sin ninguna interacción (edición, nota, envío).
  // Solo una marca para que el dueño decida — un dato de contacto de negocio nunca se purga solo.
  // Nulo = no requiere revisión. Se limpia al conservarlo o al volver a interactuar.
  retentionReviewAt           DateTime?               @map("retention_review_at") @db.Timestamptz(6)
  // Consentimiento de **marketing** (F5.6), aparte del de gestión de arriba: aceptar que el negocio
  // guarde los datos para una reserva o un pedido no es aceptar publicidad. Solo una casilla
  // explícita y no premarcada lo registra (fuente, versión del texto y fecha). La baja por el enlace
  // firmado de un correo lo deja en `marketing_unsubscribed_at` y se respeta de inmediato.
  marketingConsentAt          DateTime?               @map("marketing_consent_at") @db.Timestamptz(6)
  marketingConsentSource      String?                 @map("marketing_consent_source")
  marketingConsentTextVersion String?                 @map("marketing_consent_text_version")
  marketingUnsubscribedAt     DateTime?               @map("marketing_unsubscribed_at") @db.Timestamptz(6)
  createdAt                   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo         User?               @relation("ContactAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  submissions        FormSubmission[]
  events             ContactEvent[]
  bookings           Booking[]
  orders             Order[]
  campaignRecipients CampaignRecipient[]
  newsletterConfirmations NewsletterConfirmation[]
  emailSequenceEnrollments EmailSequenceEnrollment[]

  @@index([organizationId])
  @@index([organizationId, retentionReviewAt])
  @@map("contacts")
}

model ContactEvent {
  id        String           @id @default(uuid()) @db.Uuid
  contactId String           @map("contact_id") @db.Uuid
  type      ContactEventType
  payload   Json?
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@map("contact_events")
}

model ShortLink {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  // Único global: resuelve en la ruta pública dedicada a enlaces cortos (`/s/:slug`, distinta del
  // espacio de nombres de Site.slug en la raíz), validado con las mismas reglas de formato/
  // colisión/reservados que F2.2.
  slug             String   @unique
  destinationUrl   String   @map("destination_url")
  utm              Json?
  clickCountCached Int      @default(0) @map("click_count_cached")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  qrCodes      QrCode[]

  @@index([organizationId])
  @@map("short_links")
}

model QrCode {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  shortLinkId     String?  @map("short_link_id") @db.Uuid
  // Alternativa cuando el QR no pasa por un ShortLink propio (ERD.md §6: "puede apuntar directo a
  // una URL"). Se exige en servidor que al menos uno de los dos exista (CHECK en la migración).
  directUrl       String?  @map("direct_url")
  styleConfig     Json     @map("style_config")
  scanCountCached Int      @default(0) @map("scan_count_cached")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // NoAction, no SetNull: un QrCode que solo tiene shortLinkId (sin directUrl) quedaría violando
  // el CHECK de abajo si el enlace se borrara y la columna pasara a null. Borrar un ShortLink
  // "suelto" con un QrCode propio exige primero borrarlo/reasignarlo (no un huérfano silencioso).
  // NoAction (no Restrict) a propósito: Postgres verifica NO ACTION al final del statement, no
  // por fila — así borrar la Organization completa (que en cascada borra ShortLink y QrCode a la
  // vez, cada uno por su propio FK a organization_id) no choca contra este constraint, porque al
  // terminar el statement ya no queda ninguna fila viva de ninguno de los dos lados.
  shortLink    ShortLink?   @relation(fields: [shortLinkId], references: [id], onDelete: NoAction)

  @@index([organizationId])
  @@index([shortLinkId])
  @@map("qr_codes")
}

model AnalyticsEvent {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  siteId              String?  @map("site_id") @db.Uuid
  // Catálogo abierto (page_view/block_click/whatsapp_click/form_submit/lead_created/qr_visit/...),
  // igual que Block.type: crece con el producto sin exigir migración por cada tipo nuevo.
  type                String
  // Hash con sal rotada por sitio/día (ADR-004 punto 1) — nunca un identificador estable entre
  // días ni reversible a IP/dispositivo real. No hay columna de IP cruda a propósito.
  anonymizedVisitorId String?  @map("anonymized_visitor_id")
  utm                 Json?
  device              String?
  geoCountry          String?  @map("geo_country")
  geoCity             String?  @map("geo_city")
  // Evita doble conteo por reintento de red en eventos críticos (F3.6).
  idempotencyKey      String?  @unique @map("idempotency_key")
  // A qué se refiere el evento (F7.6, ADR-021): la página de un `page_view`, el bloque de un clic, el
  // pedido o la reserva de los eventos del servidor. Texto y no uuid: un sujeto con otra forma nunca
  // debe hacer perder el evento. Nulo en los eventos anteriores a la migración.
  subjectId           String?  @map("subject_id")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([siteId, createdAt])
  // Embudos (F7.6): cada paso busca "estos tipos, en este sitio, en este rango".
  @@index([siteId, type, createdAt])
  @@map("analytics_events")
}

model AnalyticsAggregate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  // Nulo para métricas de nivel organización (enlaces cortos y QR, F3.5/F3.6), que no pertenecen
  // a ningún sitio. El índice único de abajo es NULLS NOT DISTINCT en la migración (Postgres 15+):
  // sin eso, dos filas con site_id nulo nunca "chocarían" y el upsert del pipeline duplicaría la
  // métrica en vez de sumarla. Prisma no sabe expresar NULLS NOT DISTINCT, por eso vive en SQL.
  siteId         String?  @map("site_id") @db.Uuid
  // Granularidad diaria en formato "YYYY-MM-DD" (F3.6): suficiente para el dashboard de
  // conversión (PM §9.12) sin la cardinalidad de guardar por hora.
  period         String
  metric         String
  value          Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site?        @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([organizationId, siteId, period, metric])
  // Lectura del dashboard de conversión (F3.7): "esta organización, este rango de días".
  @@index([organizationId, period])
  @@map("analytics_aggregates")
}

// --- Soporte mínimo (F4.5) ---------------------------------------------------------------------
// Sin adjuntos hasta que exista almacenamiento de media (decisión #7). Una solicitud pertenece a una
// organización (ADR-002): se lee por membresía, nunca por un id suelto.
model SupportTicket {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  // SetNull: si la cuenta se elimina, la solicitud queda como historial de la organización.
  openedById     String?             @map("opened_by_id") @db.Uuid
  subject        String
  status         SupportTicketStatus @default(OPEN)
  closedAt       DateTime?           @map("closed_at") @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  // Última actividad (mensaje o cambio de estado): ordena las bandejas.
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  openedBy     User?            @relation("SupportTicketOpener", fields: [openedById], references: [id], onDelete: SetNull)
  messages     SupportMessage[]

  @@index([organizationId, updatedAt])
  @@index([status, updatedAt])
  @@map("support_tickets")
}

model SupportMessage {
  id         String            @id @default(uuid()) @db.Uuid
  ticketId   String            @map("ticket_id") @db.Uuid
  authorId   String?           @map("author_id") @db.Uuid
  authorRole SupportAuthorRole @map("author_role")
  body       String
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation("SupportMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

// --- Medios (PP1, ADR-006) ----------------------------------------------------------------------

enum MediaKind {
  IMAGE
  VIDEO
}

// PENDING_UPLOAD: URL de subida emitida, el archivo aún no se confirma. PROCESSING: verificado y en
// cola del worker. READY: variantes listas (solo estos se pueden usar en un bloque). FAILED: no
// era lo que decía ser o no se pudo procesar; no ocupa cuota.
enum MediaStatus {
  PENDING_UPLOAD
  PROCESSING
  READY
  FAILED
}

model MediaAsset {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  uploadedById   String?     @map("uploaded_by_id") @db.Uuid
  kind           MediaKind
  status         MediaStatus @default(PENDING_UPLOAD)
  // Nombre que tenía el archivo, solo para mostrarlo en la biblioteca (texto plano, acotado).
  fileName       String      @map("file_name")
  // Tipo verificado por bytes mágicos al confirmar (no el que declaró el navegador).
  mimeType       String      @map("mime_type")
  // Tamaño declarado del original (cuenta para la cuota mientras está pendiente o en proceso).
  sizeBytes      Int         @map("size_bytes")
  // Lo que queda guardado de verdad tras procesar: la suma de las variantes. El original se borra
  // al terminar (trae EXIF, a veces con la ubicación GPS, ADR-006 §4).
  storedBytes    Int         @default(0) @map("stored_bytes")
  width          Int?
  height         Int?
  // [{ width, key, sizeBytes }] validado con `mediaVariantsSchema` al leer.
  variants       Json        @default("[]")
  // Tonos extremos `{ darkest, lightest }` (PP3), para verificar el contraste del texto sobre la
  // imagen usada de fondo. `null` en imágenes procesadas antes de PP3: se asume el peor caso.
  tones          Json?
  failureReason  String?     @map("failure_reason")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([status, createdAt])
  @@map("media_assets")
}

// --- Reservas (F5.1, BACKLOG_FASE_5.md) ---

// Configuración de reservas de un sitio (1:1). `weeklyHours` se valida con `weeklyHoursSchema`
// (`@impulza/validation`) al escribir y al leer: nunca JSON libre.
model BookingSettings {
  siteId              String   @id @map("site_id") @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  enabled             Boolean  @default(false)
  // Zona horaria IANA del negocio: todo horario se calcula en ella (incluye cambios de horario).
  timeZone            String   @default("America/Santiago") @map("time_zone")
  weeklyHours         Json     @map("weekly_hours")
  minNoticeMinutes    Int      @default(120) @map("min_notice_minutes")
  maxAdvanceDays      Int      @default(60) @map("max_advance_days")
  bufferMinutes       Int      @default(0) @map("buffer_minutes")
  slotIntervalMinutes Int      @default(30) @map("slot_interval_minutes")
  // Feed iCal (.ics) del negocio para suscripción directa desde calendarios externos (F7.9c).
  calendarFeedToken   String?  @unique @map("calendar_feed_token")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("booking_settings")
}

// Sucursal de atención del negocio (F7.9a, ADR-024). Hasta 20 por sitio.
model BookingBranch {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  siteId         String   @map("site_id") @db.Uuid
  name           String
  address        String?
  phone          String?
  active         Boolean  @default(true)
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  site         Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        BookingStaff[]
  bookings     Booking[]

  @@index([siteId, position])
  @@index([organizationId])
  @@map("booking_branches")
}

// Profesional o prestador de atención (F7.9a, ADR-024). Hasta 50 por sitio.
model BookingStaff {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  siteId            String   @map("site_id") @db.Uuid
  branchId          String?  @map("branch_id") @db.Uuid
  name              String
  title             String?
  email             String?
  phone             String?
  avatarUrl         String?  @map("avatar_url")
  active            Boolean  @default(true)
  position          Int      @default(0)
  // Horario semanal opcional del profesional; si es null, usa el horario del sitio (F7.9b).
  weeklyHours       Json?    @map("weekly_hours")
  calendarFeedToken String?  @unique @map("calendar_feed_token")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  site         Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       BookingBranch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  services     ServiceStaff[]
  blackouts    BookingBlackout[]
  bookings     Booking[]
  googleCalendarConnections GoogleCalendarConnection[]

  @@index([siteId, position])
  @@index([organizationId])
  @@map("booking_staff")
}

// Relación N:M entre servicios y profesionales que los atienden (F7.9a).
model ServiceStaff {
  serviceId String @map("service_id") @db.Uuid
  staffId   String @map("staff_id") @db.Uuid

  service BookableService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff   BookingStaff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([serviceId, staffId])
  @@map("service_staff")
}

// Servicio que se puede reservar (corte, sesión, tour). Precio en unidad mínima + moneda ISO; el
// pago, si lo hay, es un enlace externo del negocio (Impulza no cobra: decisión #6).
model BookableService {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  siteId          String   @map("site_id") @db.Uuid
  name            String
  description     String?
  durationMinutes Int      @map("duration_minutes")
  priceAmount     Int?     @map("price_amount")
  priceCurrency   String?  @map("price_currency")
  paymentUrl      String?  @map("payment_url")
  // Seña (F5.10, ADR-013): monto fijo en la moneda del precio, cobrado al reservar si el negocio
  // tiene su cuenta de Mercado Pago conectada. `CHECK`: > 0 y ≤ precio.
  depositAmount   Int?     @map("deposit_amount")
  active          Boolean  @default(true)
  position        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  site         Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  staff        ServiceStaff[]

  @@index([siteId, position])
  @@index([organizationId])
  @@map("bookable_services")
}

// Bloqueo de agenda (feriado, vacaciones): en ese rango no se ofrece ninguna hora.
model BookingBlackout {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  siteId         String   @map("site_id") @db.Uuid
  staffId        String?  @map("staff_id") @db.Uuid
  startsAt       DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime @map("ends_at") @db.Timestamptz(6)
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        BookingStaff? @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([siteId, startsAt])
  @@index([organizationId])
  @@index([staffId])
  @@map("booking_blackouts")
}

enum BookingStatus {
  CONFIRMED
  // Esperando la seña (F5.10): ocupa la hora hasta `paymentDeadline`; al pagarse pasa a CONFIRMED.
  PENDING_PAYMENT
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum BookingSource {
  PUBLIC
  MANUAL
}

// Reserva (F5.2, F7.9a). Guarda una copia del servicio y del profesional/sucursal tal como
// era al reservar: editar o borrar el servicio/profesional después no cambia lo que se reservó.
// Sin doble reserva: restricción de exclusión `bookings_no_overlap` (en la migración, Prisma no la expresa)
// sobre `COALESCE(staff_id, '00000000-0000-0000-0000-000000000000'::uuid)` y `tstzrange(starts_at, ends_at)`.
model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  siteId          String        @map("site_id") @db.Uuid
  serviceId       String?       @map("service_id") @db.Uuid
  contactId       String?       @map("contact_id") @db.Uuid
  staffId         String?       @map("staff_id") @db.Uuid
  staffName       String?       @map("staff_name")
  branchId        String?       @map("branch_id") @db.Uuid
  branchName      String?       @map("branch_name")
  serviceName     String        @map("service_name")
  durationMinutes Int           @map("duration_minutes")
  priceAmount     Int?          @map("price_amount")
  priceCurrency   String?       @map("price_currency")
  paymentUrl      String?       @map("payment_url")
  startsAt        DateTime      @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime      @map("ends_at") @db.Timestamptz(6)
  // Zona del negocio al reservar: los avisos muestran la hora en ella.
  timeZone        String        @map("time_zone")
  customerName    String        @map("customer_name")
  customerEmail   String        @map("customer_email")
  customerPhone   String?       @map("customer_phone")
  note            String?
  status          BookingStatus @default(CONFIRMED)
  source          BookingSource @default(PUBLIC)
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  // F5.4: cuándo se envió el recordatorio (reprogramar lo vuelve a `null`). El worker lo reclama
  // con un `updateMany` condicional antes de enviar: nunca dos recordatorios.
  reminderSentAt  DateTime?     @map("reminder_sent_at") @db.Timestamptz(6)
  // Seña con Checkout Pro (F5.10, ADR-013), solo si se cobró al reservar. Mismo criterio que los
  // pedidos (F5.9): `providerPaymentId` único y asignado de forma condicional; `paymentStatus` es el
  // último estado consultado en Mercado Pago con el token del negocio. `paymentExpiredAt`: el worker
  // liberó la hora porque venció el plazo (un pago tardío la reconfirma si sigue libre).
  depositAmount        Int?      @map("deposit_amount")
  paymentDeadline      DateTime? @map("payment_deadline") @db.Timestamptz(6)
  checkoutPreferenceId String?   @map("checkout_preference_id")
  checkoutUrl          String?   @map("checkout_url")
  providerPaymentId    String?   @unique @map("provider_payment_id")
  paymentStatus        String?   @map("payment_status")
  depositPaidAt        DateTime? @map("deposit_paid_at") @db.Timestamptz(6)
  paymentExpiredAt     DateTime? @map("payment_expired_at") @db.Timestamptz(6)
  // F5.11a: cuánto se devolvió de la seña (leído de Mercado Pago; `CHECK` ≤ seña).
  depositRefundedAmount Int      @default(0) @map("deposit_refunded_amount")
  googleEventId   String?       @map("google_event_id")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  service      BookableService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  contact      Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  staff        BookingStaff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)
  branch       BookingBranch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([siteId, startsAt])
  @@index([organizationId, startsAt])
  @@index([contactId])
  @@index([staffId, startsAt])
  @@index([branchId, startsAt])
  @@map("bookings")
}

// Conexión OAuth con Google Calendar por sitio o por profesional (F7.9c, ADR-024).
// Excepción acotada a "no custodiar credenciales de terceros": los tokens se guardan cifrados
// (AES-256-GCM, AUTH_ENCRYPTION_KEY) y nunca salen en respuestas, logs ni auditoría.
model GoogleCalendarConnection {
  id                    String        @id @default(uuid()) @db.Uuid
  organizationId        String        @map("organization_id") @db.Uuid
  siteId                String        @map("site_id") @db.Uuid
  staffId               String?       @map("staff_id") @db.Uuid
  email                 String
  calendarId            String        @default("primary") @map("calendar_id")
  accessTokenEncrypted  String        @map("access_token_encrypted")
  refreshTokenEncrypted String        @map("refresh_token_encrypted")
  expiresAt             DateTime      @map("expires_at") @db.Timestamptz(6)
  status                String        @default("CONNECTED")
  channelId             String?       @map("channel_id")
  resourceId            String?       @map("resource_id")
  syncToken             String?       @map("sync_token")
  lastSyncAt            DateTime?     @map("last_sync_at") @db.Timestamptz(6)
  lastError             String?       @map("last_error")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  staff        BookingStaff? @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([siteId])
  @@index([staffId])
  @@map("google_calendar_connections")
}

// --- Catálogo y pedidos (F5.5, BACKLOG_FASE_5.md) ---

enum ProductKind {
  PHYSICAL
  DIGITAL
  SERVICE
}

enum OrderStatus {
  NEW
  PAID
  DELIVERED
  CANCELLED
}

// Categoría del catálogo de un sitio ("Cortes", "Regalos").
model ProductCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  siteId         String   @map("site_id") @db.Uuid
  name           String
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  products     Product[]

  @@index([siteId, position])
  @@index([organizationId])
  @@map("product_categories")
}

// Producto del catálogo. Precio en unidad mínima + moneda ISO. El pago es un enlace externo del
// negocio (Impulza no cobra: decisión #6). `stock` `null` = sin control de stock; con número, un
// pedido lo descuenta de forma atómica y cancelar lo devuelve (CHECK: nunca negativo).
model Product {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  siteId         String      @map("site_id") @db.Uuid
  categoryId     String?     @map("category_id") @db.Uuid
  name           String
  description    String?
  kind           ProductKind @default(PHYSICAL)
  priceAmount    Int         @map("price_amount")
  priceCurrency  String      @map("price_currency")
  // `{ url, alt }` de la biblioteca de medios, validado con `imageSchema`.
  image          Json?
  paymentUrl     String?     @map("payment_url")
  stock          Int?
  active         Boolean     @default(true)
  position       Int         @default(0)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  category     ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orders       Order[]
  files        ProductFile[]
  variants     ProductVariant[]
  orderItems   OrderItem[]

  @@index([siteId, position])
  @@index([organizationId])
  @@map("products")
}

// Pedido como **solicitud** (F5.5): el visitante deja sus datos; el negocio cobra por su cuenta y lo
// marca pagado, entregado o cancelado. Guarda una copia del producto y el precio al pedir.
model Order {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  siteId          String      @map("site_id") @db.Uuid
  productId       String?     @map("product_id") @db.Uuid
  contactId       String?     @map("contact_id") @db.Uuid
  productName     String      @map("product_name")
  productKind     ProductKind @map("product_kind")
  unitPriceAmount Int         @map("unit_price_amount")
  priceCurrency   String      @map("price_currency")
  quantity        Int
  totalAmount     Int         @map("total_amount")
  paymentUrl      String?     @map("payment_url")
  customerName    String      @map("customer_name")
  customerEmail   String      @map("customer_email")
  customerPhone   String?     @map("customer_phone")
  // Dirección de entrega (solo productos físicos).
  deliveryAddress String?     @map("delivery_address")
  note            String?
  status          OrderStatus @default(NEW)
  // `true` si el pedido descontó stock (para devolverlo al cancelar).
  stockReserved   Boolean     @default(false) @map("stock_reserved")
  paidAt          DateTime?   @map("paid_at") @db.Timestamptz(6)
  deliveredAt     DateTime?   @map("delivered_at") @db.Timestamptz(6)
  cancelledAt     DateTime?   @map("cancelled_at") @db.Timestamptz(6)
  // Cobro con Checkout Pro (F5.9, ADR-013), solo si el negocio tenía su cuenta de Mercado Pago
  // conectada al pedir. `checkoutUrl`: dónde paga el comprador; `providerPaymentId`: el pago que lo
  // marcó pagado (único: un pago nunca paga dos pedidos); `paymentStatus`: último estado informado
  // por Mercado Pago (`approved`, `pending`, `rejected`…), consultado siempre con el token del negocio.
  checkoutPreferenceId String?  @map("checkout_preference_id")
  checkoutUrl          String?  @map("checkout_url")
  checkoutExpiresAt    DateTime? @map("checkout_expires_at") @db.Timestamptz(6)
  providerPaymentId    String?  @unique @map("provider_payment_id")
  paymentStatus        String?  @map("payment_status")
  // F5.11a: cuánto se devolvió del pago (leído de Mercado Pago; `CHECK` ≤ total).
  refundedAmount       Int      @default(0) @map("refunded_amount")
  // SHA-256 del enlace "Tu pedido" que recibe el comprador (el enlace en sí nunca se guarda).
  statusTokenHash      String?  @unique @map("status_token_hash")
  // F5.11b (ADR-015): descargas entregadas del archivo en venta (tope por pedido) y la última.
  downloadCount        Int       @default(0) @map("download_count")
  lastDownloadedAt     DateTime? @map("last_downloaded_at") @db.Timestamptz(6)
  // F7.8b (ADR-023): descuento de un cupón sobre el subtotal (líneas). `total_amount` es lo que se
  // cobra (subtotal − descuento); el código se copia para que el pedido lo conserve aunque se borre.
  discountAmount       Int       @default(0) @map("discount_amount")
  couponId             String?   @map("coupon_id") @db.Uuid
  couponCode           String?   @map("coupon_code")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  coupon       Coupon?      @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items        OrderItem[]

  @@index([organizationId, createdAt])
  @@index([siteId, createdAt])
  @@index([contactId])
  @@map("orders")
}

// Variante de un producto (F7.8a, ADR-023): talla, color o formato, con su precio (o el del
// producto) y su stock (o sin control). Un producto con variantes activas exige elegir una al pedir
// y su stock es el de la variante. Nombre único por producto; `CHECK` de stock y precio ≥ 0.
model ProductVariant {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  siteId         String   @map("site_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  name           String
  // Sin valor = el precio del producto.
  priceAmount    Int?     @map("price_amount")
  // Sin valor = sin control de stock.
  stock          Int?
  sku            String?
  position       Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]

  @@unique([productId, name])
  @@index([productId, position])
  @@index([organizationId])
  @@map("product_variants")
}

// Cupón de descuento de un sitio (F7.8b, ADR-023). Porcentaje (1–100) o monto fijo en `currency`;
// mínimo de compra, ventana y tope de usos opcionales. El código se guarda en mayúsculas y es único
// por sitio. El uso se cuenta con una actualización condicional en la transacción del pedido; el
// `CHECK` de la base impide pasar el tope aunque algo falle arriba.
model Coupon {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  siteId          String    @map("site_id") @db.Uuid
  code            String
  description     String?
  // `percent` o `fixed` (CHECK en la migración).
  kind            String
  percentOff      Int?      @map("percent_off")
  amountOff       Int?      @map("amount_off")
  // Moneda del monto fijo y del mínimo de compra; un porcentaje sin mínimo vale en cualquier moneda.
  currency        String?
  minSubtotal     Int?      @map("min_subtotal")
  startsAt        DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime? @map("ends_at") @db.Timestamptz(6)
  maxRedemptions  Int?      @map("max_redemptions")
  redemptionCount Int       @default(0) @map("redemption_count")
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@unique([siteId, code])
  @@index([organizationId])
  @@map("coupons")
}

// Línea de un pedido (F7.8a, ADR-023): copia del producto, la variante y el precio al pedir, y de
// dónde se reservó stock (`product`, `variant` o nulo) para devolverlo exacto al cancelar. Los
// pedidos anteriores reciben su línea en la migración. Las columnas del pedido quedan como resumen.
model OrderItem {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  orderId         String      @map("order_id") @db.Uuid
  productId       String?     @map("product_id") @db.Uuid
  variantId       String?     @map("variant_id") @db.Uuid
  productName     String      @map("product_name")
  variantName     String?     @map("variant_name")
  productKind     ProductKind @map("product_kind")
  unitPriceAmount Int         @map("unit_price_amount")
  quantity        Int
  lineTotalAmount Int         @map("line_total_amount")
  stockSource     String?     @map("stock_source")
  position        Int         @default(0)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId, position])
  @@index([organizationId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

enum ProductFileStatus {
  PENDING_UPLOAD
  READY
  FAILED
}

// Archivo que se vende con un producto digital (F5.11b, ADR-015). Vive en el bucket PRIVADO: solo se
// lee con una URL prefirmada de pocos minutos que la API entrega a un pedido pagado. Un producto
// tiene a lo más un archivo `READY` (índice único parcial en la migración); reemplazarlo borra el
// anterior. Cuenta para la cuota de almacenamiento del plan, igual que los medios.
model ProductFile {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  productId      String            @map("product_id") @db.Uuid
  // Nombre con que se descarga (validado: sin rutas ni caracteres de control). La clave del bucket
  // la decide el servidor y nunca usa este nombre.
  fileName       String            @map("file_name")
  contentType    String            @map("content_type")
  sizeBytes      Int               @map("size_bytes")
  status         ProductFileStatus @default(PENDING_UPLOAD)
  uploadedById   String?           @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  readyAt        DateTime?         @map("ready_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, status])
  @@index([organizationId, status])
  @@map("product_files")
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
  CANCELLED
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  FAILED
  // No se envió: se dio de baja o dejó de cumplir el segmento entre el alta del envío y su turno.
  SKIPPED
}

// Campaña de email (F5.6): a nivel organización. El segmento se guarda como JSON validado con
// `campaignSegmentSchema`; al enviar se congela la lista en `CampaignRecipient` y el worker la
// despacha respetando el límite por hora del plan.
model Campaign {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  createdById    String?        @map("created_by") @db.Uuid
  name           String
  subject        String
  // HTML saneado en el servidor (mismo saneamiento que el texto enriquecido de los bloques).
  bodyHtml       String         @map("body_html")
  segment        Json
  status         CampaignStatus @default(DRAFT)
  recipientCount Int            @default(0) @map("recipient_count")
  // Límite por hora del plan al iniciar el envío (lo decide la API; el worker no resuelve planes).
  // `null` = sin límite. Una organización envía una campaña a la vez.
  emailsPerHour  Int?           @map("emails_per_hour")
  sendStartedAt  DateTime?      @map("send_started_at") @db.Timestamptz(6)
  sentAt         DateTime?      @map("sent_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?               @relation("CampaignAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  recipients   CampaignRecipient[]

  @@index([organizationId, createdAt])
  @@index([status])
  @@map("campaigns")
}

model CampaignRecipient {
  id             String                  @id @default(uuid()) @db.Uuid
  campaignId     String                  @map("campaign_id") @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  contactId      String?                 @map("contact_id") @db.Uuid
  email          String
  status         CampaignRecipientStatus @default(PENDING)
  sentAt         DateTime?               @map("sent_at") @db.Timestamptz(6)
  error          String?
  unsubscribedAt DateTime?               @map("unsubscribed_at") @db.Timestamptz(6)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([organizationId, sentAt])
  @@map("campaign_recipients")
}

// --- IA (F6.2, ADR-010) -------------------------------------------------------------------------
// Conexiones y rutas son de **plataforma** (sin `organizationId`), como el catálogo de planes: las
// administra solo un superadministrador (F6.2b). `AiUsage` sí es por organización.

enum AiProviderKind {
  OPENAI_COMPATIBLE
  ANTHROPIC
}

enum AiJsonMode {
  json_schema
  json_object
  prompt
}

enum AiUsageOutcome {
  ok
  timeout
  invalid_output
  rate_limited
  auth_error
  refused
  provider_error
}

model AiConnection {
  id                    String         @id @default(uuid()) @db.Uuid
  name                  String         @unique
  kind                  AiProviderKind
  // Obligatoria para OPENAI_COMPATIBLE (servidor propio o nube); opcional para ANTHROPIC.
  baseUrl               String?        @map("base_url")
  // AES-256-GCM con AUTH_ENCRYPTION_KEY (`encryptSecret` de @impulza/auth). Nunca en claro, nunca de
  // vuelta por la API: solo `apiKeyHint` (últimos 4 caracteres) para reconocerla.
  apiKeyEncrypted       String?        @map("api_key_encrypted")
  apiKeyHint            String?        @map("api_key_hint")
  model                 String
  jsonMode              AiJsonMode     @default(json_schema) @map("json_mode")
  timeoutMs             Int            @default(30000) @map("timeout_ms")
  // Micro-dólares por millón de tokens (0 = modelo propio). Enteros: nunca float para dinero (ST §8).
  inputMicroUsdPerMTok  Int            @default(0) @map("input_micro_usd_per_mtok")
  outputMicroUsdPerMTok Int            @default(0) @map("output_micro_usd_per_mtok")
  enabled               Boolean        @default(true)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  routes AiRoute[]
  usage  AiUsage[]

  @@map("ai_connections")
}

// Ruta de una tarea (`AI_TASKS` de @impulza/ai): sus conexiones en orden de respaldo (0 = principal).
model AiRoute {
  id           String       @id @default(uuid()) @db.Uuid
  task         String
  position     Int
  connectionId String       @map("connection_id") @db.Uuid
  connection   AiConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([task, connectionId])
  @@index([task, position])
  @@map("ai_routes")
}

// Un intento contra un proveedor. **Nunca** guarda el prompt ni la respuesta (ADR-004, ADR-010):
// solo lo necesario para costo, cuota y diagnóstico. `requestId` agrupa los intentos de una misma
// solicitud (reintentos y respaldo): la cuota cuenta solicitudes, no intentos.
model AiUsage {
  id             String         @id @default(uuid()) @db.Uuid
  // Null en las pruebas de conexión desde la superadministración.
  organizationId String?        @map("organization_id") @db.Uuid
  userId         String?        @map("user_id") @db.Uuid
  requestId      String         @map("request_id") @db.Uuid
  task           String
  connectionId   String?        @map("connection_id") @db.Uuid
  providerKind   AiProviderKind @map("provider_kind")
  model          String
  outcome        AiUsageOutcome
  inputTokens    Int            @default(0) @map("input_tokens")
  outputTokens   Int            @default(0) @map("output_tokens")
  costMicroUsd   Int            @default(0) @map("cost_micro_usd")
  durationMs     Int            @default(0) @map("duration_ms")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation("AiUsageUser", fields: [userId], references: [id], onDelete: SetNull)
  connection   AiConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([connectionId, createdAt])
  @@index([requestId])
  @@map("ai_usage")
}

// --- Pruebas A/B (F6.5, ADR-011) -----------------------------------------------------------------
// Una prueba compara la configuración publicada de un bloque de acción (o del encabezado de perfil)
// con una variante B de solo texto/estilo (`abVariantSchema` de `@impulza/validation`). Los conteos
// no viven acá: son métricas de `AnalyticsAggregate` (`ab:<evento>:<id>:<a|b>`), sin datos
// personales. A lo sumo una prueba en curso por bloque: índice único parcial en la migración.

enum AbTestStatus {
  RUNNING
  ENDED
}

model AbTest {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  siteId         String       @map("site_id") @db.Uuid
  pageId         String       @map("page_id") @db.Uuid
  blockId        String       @map("block_id") @db.Uuid
  name           String
  // Clave pública opaca que decide el reparto (`abVariantFor`) y viaja en la página pública en vez
  // del id: no revela nada interno ni permite adivinar otras pruebas.
  key            String       @unique
  blockType      String       @map("block_type")
  // Copia de la configuración publicada al empezar: la variante A que se comparó, aunque después
  // se publique otra (p. ej. al aplicar B). El historial de la prueba no cambia con el bloque.
  variantA       Json         @map("variant_a")
  variantB       Json         @map("variant_b")
  status         AbTestStatus @default(RUNNING)
  // Variante que el usuario decidió aplicar al terminar (acción explícita), o nula.
  appliedVariant String?      @map("applied_variant")
  startedAt      DateTime     @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt        DateTime?    @map("ended_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  page         Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  block        Block        @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([siteId, status])
  @@index([pageId, status])
  @@map("ab_tests")
}

// Modo campaña (F7.7, ADR-022): una página publicada del sitio con una ventana de fechas. Fuera de la
// ventana la página no se sirve; dentro, opcionalmente toma la raíz del sitio. Las fechas son UTC.
// `startRevalidatedAt`/`endRevalidatedAt` los marca el worker al avisar a apps/web que invalide la
// caché al empezar y al terminar (una sola vez cada uno).
model PageCampaign {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  siteId             String    @map("site_id") @db.Uuid
  pageId             String    @map("page_id") @db.Uuid
  name               String
  // `TEMPLATE_OBJECTIVES` (captar, vender, reservar, mostrar, compartir).
  objective          String
  startsAt           DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt             DateTime  @map("ends_at") @db.Timestamptz(6)
  replaceHome        Boolean   @default(false) @map("replace_home")
  utmCampaign        String    @map("utm_campaign")
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)
  startRevalidatedAt DateTime? @map("start_revalidated_at") @db.Timestamptz(6)
  endRevalidatedAt   DateTime? @map("end_revalidated_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  page         Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([organizationId, siteId])
  // Resolución pública: "campañas de este sitio vigentes ahora".
  @@index([siteId, startsAt, endsAt])
  @@index([pageId])
  @@map("page_campaigns")
}

// Embudo de conversión de un sitio (F7.6, ADR-021). Solo la definición: el informe se calcula al
// consultar sobre `analytics_events`, nunca se guarda. `steps` es `funnelStepsSchema` de
// `@impulza/validation` (2 a 6 pasos, cada uno con eventos de un catálogo cerrado), validado al
// guardar y otra vez al leer.
model Funnel {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  siteId         String   @map("site_id") @db.Uuid
  name           String
  steps          Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([organizationId, siteId])
  @@map("funnels")
}

// --- Automatizaciones básicas (F6.7) ---------------------------------------------------------------
// Disparador → acción, de un catálogo cerrado (`createAutomationSchema` de `@impulza/validation`). La
// API encola un evento (solo ids) y el worker lo procesa. `AutomationRun` es el registro por
// ejecución y la garantía de idempotencia: único (automatización, evento).

enum AutomationRunStatus {
  PENDING
  SUCCEEDED
  FAILED
  SKIPPED
}

model Automation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  trigger        String
  // `automationActionSchema`: { type, ...config }. Validado al guardar y otra vez al ejecutar.
  action         Json
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         AutomationRun[]

  @@index([organizationId, trigger, enabled])
  @@map("automations")
}

model AutomationRun {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  automationId   String              @map("automation_id") @db.Uuid
  // `trigger:subjectId`: el evento. Con `automation_id`, la clave única que evita correr dos veces.
  eventKey       String              @map("event_key")
  trigger        String
  subjectId      String              @map("subject_id") @db.Uuid
  status         AutomationRunStatus @default(PENDING)
  attempts       Int                 @default(0)
  // Motivo técnico de una falla u omisión, sin datos personales.
  detail         String?
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt     DateTime?           @map("finished_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  automation   Automation   @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, eventKey])
  @@index([organizationId, createdAt])
  @@map("automation_runs")
}

// Un cobro (F4.6a, ADR-012). Registro contable: nunca se borra en cascada (el SII exige
// conservarlo), por eso `Restrict` hacia la organización y la suscripción.
model Payment {
  id                String            @id @default(uuid()) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  subscriptionId    String            @map("subscription_id") @db.Uuid
  gateway           PaymentGateway
  // Orden de compra determinista (`buyOrderFor`): única, así un cobro nunca se ejecuta dos veces.
  buyOrder          String            @unique @map("buy_order")
  // Pesos enteros, IVA incluido; neto + IVA = monto (ADR-012 §5).
  amount            Int
  netAmount         Int               @map("net_amount")
  vatAmount         Int               @map("vat_amount")
  currency          String
  periodStart       DateTime          @map("period_start") @db.Timestamptz(6)
  periodEnd         DateTime          @map("period_end") @db.Timestamptz(6)
  attempt           Int               @default(1)
  status            PaymentStatus     @default(PENDING)
  responseCode      Int?              @map("response_code")
  authorizationCode String?           @map("authorization_code")
  // Id del pago en la pasarela cuando es distinto de la orden (Mercado Pago, F4.6b): con él se
  // reembolsa. En Webpay el reembolso usa `buyOrder` y esto queda nulo.
  providerPaymentId String?           @map("provider_payment_id")
  // Motivo técnico de un rechazo, sin datos de tarjeta.
  failureReason     String?           @map("failure_reason")
  paidAt            DateTime?         @map("paid_at") @db.Timestamptz(6)
  refundedAmount    Int               @default(0) @map("refunded_amount")
  refundedAt        DateTime?         @map("refunded_at") @db.Timestamptz(6)
  taxDocumentStatus TaxDocumentStatus @default(PENDING) @map("tax_document_status")
  taxDocumentNumber String?           @map("tax_document_number")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([subscriptionId])
  @@index([status, createdAt])
  @@map("payments")
}

// Un paso por la pasarela para contratar un plan (F4.6a): une el token de la pasarela con quién,
// qué plan y qué ciclo, para que el retorno no confíe en nada que traiga el navegador.
model BillingCheckout {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  userId         String                @map("user_id") @db.Uuid
  planId         String                @map("plan_id") @db.Uuid
  billingCycle   BillingCycle          @map("billing_cycle")
  gateway        PaymentGateway
  // Token de la pasarela (TBK_TOKEN / id de preapproval). Único: un retorno repetido no crea nada.
  token          String                @unique
  status         BillingCheckoutStatus @default(OPEN)
  // Resultado técnico si falló (código de la pasarela), sin datos personales.
  failureReason  String?               @map("failure_reason")
  subscriptionId String?               @map("subscription_id") @db.Uuid
  expiresAt      DateTime              @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime?             @map("completed_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@index([organizationId, createdAt])
  @@map("billing_checkouts")
}

// Aviso de pasarela recibido (F4.6b). Se registra antes de procesarlo: un duplicado no tiene efecto.
model PaymentWebhookEvent {
  id          String         @id @default(uuid()) @db.Uuid
  gateway     PaymentGateway
  eventId     String         @map("event_id")
  topic       String
  receivedAt  DateTime       @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime?      @map("processed_at") @db.Timestamptz(6)

  @@unique([gateway, eventId])
  @@map("payment_webhook_events")
}

// Prueba de que un usuario aceptó un documento legal en una versión dada (ADR-012 §3). Se
// conserva aunque el usuario salga de la organización.
model LegalAcceptance {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  // `terms` | `withdrawal_notice` | `privacy`
  document       String
  version        String
  // Dónde se aceptó: `checkout`, `register`…
  context        String
  acceptedAt     DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId, document])
  @@index([organizationId])
  @@map("legal_acceptances")
}

// La cuenta de Mercado Pago **del negocio**, conectada por OAuth (F5.8, ADR-013). El dinero de sus
// ventas va directo a esa cuenta: Impulza solo crea los cobros a su nombre. Excepción acotada a "no
// custodiar credenciales de terceros": los tokens se guardan cifrados (AES-256-GCM,
// AUTH_ENCRYPTION_KEY), nunca salen en respuestas, logs ni auditoría, y desconectar los borra.
model PaymentAccount {
  id                    String               @id @default(uuid()) @db.Uuid
  organizationId        String               @map("organization_id") @db.Uuid
  provider              PaymentGateway
  // Id de la cuenta en Mercado Pago (no es secreto): evita conectar la misma cuenta a dos negocios
  // sin que se note y permite verificar a quién pertenece un pago.
  providerUserId        String               @map("provider_user_id")
  accessTokenEncrypted  String               @map("access_token_encrypted")
  refreshTokenEncrypted String               @map("refresh_token_encrypted")
  expiresAt             DateTime             @map("expires_at") @db.Timestamptz(6)
  // false = credenciales de prueba de Mercado Pago (no mueven dinero real).
  liveMode              Boolean              @map("live_mode")
  status                PaymentAccountStatus @default(CONNECTED)
  // Motivo técnico del último error (sin tokens ni datos personales).
  lastError             String?              @map("last_error")
  connectedById         String?              @map("connected_by_id") @db.Uuid
  connectedAt           DateTime             @default(now()) @map("connected_at") @db.Timestamptz(6)
  lastRefreshedAt       DateTime?            @map("last_refreshed_at") @db.Timestamptz(6)
  updatedAt             DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Una cuenta por pasarela por organización.
  @@unique([organizationId, provider])
  @@index([status, expiresAt])
  @@map("payment_accounts")
}

// --- Webhooks salientes (F7.2, ADR-017) ---

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
  // El destino se pausó, desactivó o borró antes de entregar.
  SKIPPED
}

// Destino de webhooks de un negocio. La URL (que puede llevar un token de Zapier o Make) y el
// secreto solo los ven OWNER/ADMIN (`webhooks.manage`); el secreto se guarda cifrado y se muestra
// una sola vez. `events` se valida con `WEBHOOK_EVENT_TYPES` al escribir.
model WebhookEndpoint {
  id                  String    @id @default(uuid()) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  url                 String
  description         String?
  events              String[]
  secretEncrypted     String    @map("secret_encrypted")
  active              Boolean   @default(true)
  // Motivo si lo desactivó el sistema: `gone` (410) o `too_many_failures`. `null` si lo pausó una persona.
  disabledReason      String?   @map("disabled_reason")
  disabledAt          DateTime? @map("disabled_at") @db.Timestamptz(6)
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  lastSuccessAt       DateTime? @map("last_success_at") @db.Timestamptz(6)
  lastFailureAt       DateTime? @map("last_failure_at") @db.Timestamptz(6)
  createdById         String?   @map("created_by_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId])
  @@map("webhook_endpoints")
}

// Una entrega de un evento a un destino. `eventId` es el mismo en cada reintento (el receptor
// descarta duplicados) y único por destino. `payload` lleva datos personales de los clientes del
// negocio: se borra a los 30 días (ADR-004, ADR-017 §4).
model WebhookDelivery {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  endpointId     String                @map("endpoint_id") @db.Uuid
  eventId        String                @map("event_id") @db.Uuid
  eventType      String                @map("event_type")
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime?             @map("next_attempt_at") @db.Timestamptz(6)
  lastStatusCode Int?                  @map("last_status_code")
  lastError      String?               @map("last_error")
  lastDurationMs Int?                  @map("last_duration_ms")
  deliveredAt    DateTime?             @map("delivered_at") @db.Timestamptz(6)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  endpoint     WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventId])
  @@index([endpointId, createdAt])
  @@index([organizationId, createdAt])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

// --- Newsletter con doble confirmación (F7.4, ADR-019) ---

// Solicitud de suscripción pendiente. **No** es un contacto: el contacto se crea o actualiza recién
// cuando la persona confirma desde su correo. El token viaja solo en ese correo; acá se guarda su
// SHA-256. Las no confirmadas se borran al día siguiente de vencer y las confirmadas a los 30 días.
model NewsletterConfirmation {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  siteId             String    @map("site_id") @db.Uuid
  email              String
  name               String?
  tokenHash          String    @unique @map("token_hash")
  consentTextVersion String    @map("consent_text_version")
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(6)
  confirmedAt        DateTime? @map("confirmed_at") @db.Timestamptz(6)
  contactId          String?   @map("contact_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([siteId, email, createdAt])
  @@index([organizationId, confirmedAt])
  @@index([expiresAt])
  @@map("newsletter_confirmations")
}

// --- Secuencias de correo (F7.5, ADR-020) ---

enum SequenceEnrollmentStatus {
  ACTIVE
  COMPLETED
  STOPPED
}

enum SequenceSendStatus {
  SENT
  FAILED
  SKIPPED
}

// Serie de correos que arranca con un evento del catálogo de automatizaciones. `emailsPerHour` es
// el límite del plan congelado por la API al crearla o encenderla (el worker no conoce los planes).
model EmailSequence {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  trigger        String
  enabled        Boolean  @default(true)
  emailsPerHour  Int?     @map("emails_per_hour")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps        EmailSequenceStep[]
  enrollments  EmailSequenceEnrollment[]

  @@index([organizationId, trigger, enabled])
  @@map("email_sequences")
}

// Un correo de la secuencia. `delayHours` cuenta desde el paso anterior (o desde la inscripción).
// `bodyHtml` llega saneado por la API (misma política que las campañas).
model EmailSequenceStep {
  id         String   @id @default(uuid()) @db.Uuid
  sequenceId String   @map("sequence_id") @db.Uuid
  position   Int
  delayHours Int      @map("delay_hours")
  subject    String
  bodyHtml   String   @map("body_html")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sequence EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, position])
  @@map("email_sequence_steps")
}

// Un contacto dentro de una secuencia: **una vez por secuencia** (único). `nextStep` es la posición
// del próximo correo y `nextSendAt` su hora; al reclamarlo, el worker la corre 15 minutos (concesión).
model EmailSequenceEnrollment {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  sequenceId     String                   @map("sequence_id") @db.Uuid
  contactId      String                   @map("contact_id") @db.Uuid
  eventKey       String                   @map("event_key")
  status         SequenceEnrollmentStatus @default(ACTIVE)
  stopReason     String?                  @map("stop_reason")
  nextStep       Int                      @default(0) @map("next_step")
  nextSendAt     DateTime?                @map("next_send_at") @db.Timestamptz(6)
  enrolledAt     DateTime                 @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  finishedAt     DateTime?                @map("finished_at") @db.Timestamptz(6)
  updatedAt      DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sequence     EmailSequence       @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contact      Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sends        EmailSequenceSend[]

  @@unique([sequenceId, contactId])
  @@index([status, nextSendAt])
  @@index([organizationId, contactId])
  @@map("email_sequence_enrollments")
}

// Registro de cada correo enviado (o fallido/omitido). Único por inscripción y paso: un reintento
// nunca envía dos veces. También es lo que se cuenta para el límite por hora.
model EmailSequenceSend {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  enrollmentId   String             @map("enrollment_id") @db.Uuid
  stepPosition   Int                @map("step_position")
  status         SequenceSendStatus
  error          String?
  sentAt         DateTime           @default(now()) @map("sent_at") @db.Timestamptz(6)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollment   EmailSequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, stepPosition])
  @@index([organizationId, sentAt])
  @@map("email_sequence_sends")
}
