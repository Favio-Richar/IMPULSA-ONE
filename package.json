{
  "name": "impulza-one",
  "private": true,
  "version": "0.0.0",
  "description": "Impulza One — plataforma SaaS de identidad digital, captación de clientes y ventas.",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
